{
  "manifest_version": 3,
  "name": "AI DSA Coach",
  "version": "1.0.0",
  "description": "An AI-powered LeetCode learning assistant that guides you step-by-step to solutions.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI DSA Coach"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ]
}
